# Copy to .env on the host, next to compose.yaml. Never commit the filled-in file.

# Tailscale auth key for the sidecar node (create in the Tailscale admin console)
TS_AUTHKEY=
TS_HOSTNAME=recon

# sign-in users, name:hash pairs, comma-separated (hash: uv run python -m api.workspace hash)
RECON_USERS=
# bearer token for the MCP endpoint at /mcp (python -c "import secrets; print(secrets.token_urlsafe(32))")
RECON_MCP_TOKEN=
# the public host name, e.g. recon.<tailnet>.ts.net: links in MCP results and the MCP host allow-list
RECON_PUBLIC_HOST=
# whose lists and saved searches the MCP tools work on (defaults to firmable)
RECON_USER=
