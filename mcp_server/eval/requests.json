              {"tool": "search_accounts", "args": {"template": "kev", "industry": "Education"}}]},
  {"id": 14, "request": "Banks that run Microsoft Exchange on-prem.",
   "expect": [{"tool": "search_accounts", "args": {"template": "exchange", "industry": "Financial services"}},
              {"tool": "search_accounts", "args": {"software": "exchange", "industry": "Financial services"}}]},
  {"id": 15, "request": "Who is exposed to Log4Shell?",
   "expect": [{"tool": "cve_exposure", "args": {"cve_or_name": "log4shell"}}, {"tool": "cve_exposure", "args": {"cve_or_name": "CVE-2021-44228"}}]},
  {"id": 16, "request": "Australian companies that already invest in security but still have gaps.",
   "expect": [{"tool": "search_accounts", "args": {"template": "mature", "country": "AU"}}]},
  {"id": 17, "request": "Exposed firewall or VPN admin panels, but only where we're sure who the company is.",
   "expect": [{"tool": "search_accounts", "args": {"template": "edge", "strong_identity": true}},
              {"tool": "search_accounts", "args": {"template": "edge-kev", "strong_identity": true}}]},
  {"id": 18, "request": "Look up Toyota.",
   "expect": [{"tool": "search_accounts", "args": {"query": "toyota"}}]}
