[
  {"id": 1, "request": "Find UK manufacturers running FortiGate that also have a known-exploited CVE.",
   "expect": [{"tool": "search_accounts", "args": {"template": "edge-kev", "country": "GB", "industry": "Manufacturing"}},
              {"tool": "search_accounts", "args": {"template": "kev", "software": "fortigate", "country": "GB", "industry": "Manufacturing"}},
              {"tool": "search_accounts", "args": {"template": "edge-kev", "software": "fortigate", "country": "GB", "industry": "Manufacturing"}}]},
  {"id": 2, "request": "Which accounts are exposed to Citrix Bleed?",
