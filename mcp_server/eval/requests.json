              {"tool": "search_accounts", "args": {"template": "p1", "country": "US", "limit": 10}}]},
  {"id": 6, "request": "Tell me everything you have on chevron.com.",
   "expect": [{"tool": "get_account", "args": {"account_id": "chevron.com"}}]},
  {"id": 7, "request": "Which healthcare companies have RDP or databases open to the internet?",
   "expect": [{"tool": "search_accounts", "args": {"template": "remote", "industry": "Healthcare"}}]},
  {"id": 8, "request": "Hospitals and clinics still on end-of-life Windows servers.",
   "expect": [{"tool": "search_accounts", "args": {"template": "legacy", "industry": "Healthcare"}}]},
  {"id": 9, "request": "Which companies in France are affected by CVE-2024-38475?",
   "expect": [{"tool": "cve_exposure", "args": {"cve_or_name": "CVE-2024-38475", "country": "FR"}}]},
  {"id": 10, "request": "Commercial companies with industrial control systems exposed online.",
   "expect": [{"tool": "search_accounts", "args": {"template": "ot", "sector": "commercial"}}]},
