  {"id": 12, "request": "Create CRM tasks for bbci.co.uk and chevron.com so I can import them into HubSpot.",
   "expect": [{"tool": "export_crm_tasks", "args": {"account_ids": ["bbci.co.uk", "chevron.com"]}}]},
  {"id": 13, "request": "Universities running software with known-exploited vulnerabilities.",
